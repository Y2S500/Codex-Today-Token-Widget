<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="MainWindow"
        Title="Codex Token Usage"
        Width="420" Height="316"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        ResizeMode="NoResize" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#99FFFFFF"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#22FFFFFF"/>
          <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Width" Value="74"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="RefreshBg" Background="#22FFFFFF" CornerRadius="7" Padding="8,3">
              <TextBlock Text="Refresh" FontFamily="Segoe UI" FontSize="11" Foreground="#F2FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RefreshBg" Property="Background" Value="#38FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LabelText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8FFFFFFF"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F2FFFFFF"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
  </Window.Resources>
  <Border x:Name="RootBorder" CornerRadius="16" Background="#FF181828" BorderBrush="#304ADE80" BorderThickness="1" Padding="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Ellipse Width="9" Height="9" Fill="#4ADE80" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Vertical">
          <TextBlock Text="Codex Today Token" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
          <TextBlock x:Name="StatusText" Text="正在读取…" FontSize="10" Foreground="#88FFFFFF"/>
        </StackPanel>
        <Button x:Name="CompactButton" Grid.Column="2" Style="{StaticResource IconButton}" Content="—" ToolTip="紧凑模式"/>
        <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="✕" ToolTip="退出"/>
      </Grid>

      <StackPanel Grid.Row="1" Margin="0,13,0,10">
        <TextBlock Text="今日 Token" Style="{StaticResource LabelText}"/>
        <TextBlock x:Name="TotalValue" Text="—" FontSize="33" FontWeight="Bold" Foreground="#FFFFFFFF"/>
      </StackPanel>

      <UniformGrid x:Name="DetailsGrid" Grid.Row="2" Columns="3" Rows="2" Margin="0,0,0,12">
        <StackPanel Margin="0,0,8,8">
          <TextBlock Text="输入" Style="{StaticResource LabelText}"/>
          <TextBlock x:Name="InputValue" Text="—" Style="{StaticResource ValueText}"/>
        </StackPanel>
        <StackPanel Margin="0,0,8,8">
          <TextBlock Text="缓存输入" Style="{StaticResource LabelText}"/>
          <TextBlock x:Name="CachedValue" Text="—" Style="{StaticResource ValueText}"/>
        </StackPanel>
        <StackPanel Margin="0,0,0,8">
          <TextBlock Text="未缓存输入" Style="{StaticResource LabelText}"/>
          <TextBlock x:Name="UncachedValue" Text="—" Style="{StaticResource ValueText}"/>
        </StackPanel>
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="输出" Style="{StaticResource LabelText}"/>
          <TextBlock x:Name="OutputValue" Text="—" Style="{StaticResource ValueText}"/>
        </StackPanel>
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="推理" Style="{StaticResource LabelText}"/>
          <TextBlock x:Name="ReasoningValue" Text="—" Style="{StaticResource ValueText}"/>
        </StackPanel>
        <StackPanel Margin="0,0,0,0">
          <TextBlock Text="调用" Style="{StaticResource LabelText}"/>
          <TextBlock x:Name="CallsValue" Text="—" Style="{StaticResource ValueText}"/>
        </StackPanel>
      </UniformGrid>

      <Border Grid.Row="3" Background="#14FFFFFF" CornerRadius="8" Padding="10,7" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="当前模型" Style="{StaticResource LabelText}"/>
            <TextBlock x:Name="ModelValue" Text="—" Style="{StaticResource ValueText}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <StackPanel Grid.Column="1" HorizontalAlignment="Right">
            <TextBlock Text="今日预估费用" Style="{StaticResource LabelText}" HorizontalAlignment="Right"/>
            <TextBlock x:Name="CostValue" Text="—" FontSize="16" FontWeight="Bold" Foreground="#FF4ADE80" HorizontalAlignment="Right"/>
            <TextBlock x:Name="PricingSourceText" Text="官网价目表" FontSize="9" Foreground="#66FFFFFF" HorizontalAlignment="Right"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="4" x:Name="FooterGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="UpdatedText" Text="尚未更新" VerticalAlignment="Center" FontSize="10" Foreground="#77FFFFFF" TextTrimming="CharacterEllipsis"/>
        <CheckBox x:Name="TopmostCheck" Grid.Column="1" Content="置顶" IsChecked="True" Foreground="#BBFFFFFF" FontSize="11" Margin="4,0,8,0" VerticalAlignment="Center"/>
        <Button x:Name="RefreshButton" Grid.Column="2" Style="{StaticResource ActionButton}" ToolTip="Refresh"/>
      </Grid>
    </Grid>
  </Border>
</Window>